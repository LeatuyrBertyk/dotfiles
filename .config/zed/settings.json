{
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
      "enable_thinking": true
    },
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "file_icons": true,
    "tree_view": true
  },
  "project_panel": {
    "entry_spacing": "standard",
    "dock": "left",
    "default_width": 200,
    "auto_fold_dirs": false
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
    "thumb": "always",
  },
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": [
    "monospace"
  ],
  "buffer_font_family": "Hack Nerd Font",
  "use_on_type_format": true,
  "soft_wrap": "editor_width",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "icon_theme": "Symbols Icon Theme",
  "ui_font_size": 15,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Aura Dark (Soft Text)",
  },
}
